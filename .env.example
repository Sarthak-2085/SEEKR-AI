# Optional server configuration. Local browsing and search need no credentials.
PORT=4173
# Admin bearer token for management API. Disabled when unset.
INGEST_TOKEN=
# Optional local, OpenAI-compatible summarizer. Leave empty for free deterministic summaries.
AI_SUMMARY_URL=
AI_MODEL=
AI_API_KEY=
# Optional trusted browser origin. The client and API normally use the same origin.
FRONTEND_ORIGIN=
# Set to 0 to disable automatic feed checks.
SEEKR_AUTO_INGEST=1
# Hosted only. Matches the verified platform email of the editorial operator.
CURATOR_EMAIL=
# For a separate, trusted machine importing official feeds into a hosted Site.
FEED_IMPORT_TOKEN=
SEEKR_SITE_URL=
SEEKR_SITE_ACCESS=
